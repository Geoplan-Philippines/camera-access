# ===========================================================================
# Eagle Cement - Camera (go2rtc & Python) RTSP Configuration
# ===========================================================================
# Put your Hikvision camera RTSP URLs here.
#
# Format: rtsp://<username>:<password>@<camera-ip>:<port>/Streaming/Channels/<channel>
# Channels:
#   101 / 201 / 301 = Main Stream (High Res HD)
#   102 / 202 / 302 = Sub Stream (Low Res / Fast WebRTC)
# ===========================================================================

# Gate Dome (PTZ / Gate Overview)
CCTV_DOME_URL=rtsp://admin:password@192.168.100.134:554/Streaming/Channels/101

# Gate Face Recognition (Driver ID)
CCTV_FACE_URL=rtsp://admin:password@192.168.100.134:554/Streaming/Channels/102

# Gate License Plate Recognition (ANPR)
CCTV_PLATE_URL=rtsp://admin:password@192.168.100.134:554/Streaming/Channels/101

# Python OpenCV script endpoints
RTSP_URL=rtsp://admin:password@192.168.100.134:554/Streaming/Channels/101
RTSP_SUB_URL=rtsp://admin:password@192.168.100.134:554/Streaming/Channels/102
